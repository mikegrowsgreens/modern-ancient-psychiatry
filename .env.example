# Copy to .env.local and fill in. Never commit .env.local.
#
# NEXT_PUBLIC_* values are inlined at BUILD time, not read at runtime.
# They must be set locally before `npm run build`, not on the server.

# --- Site ---
# Absolute origin. Drives metadataBase, canonical URLs, OG image URLs, sitemap.
NEXT_PUBLIC_SITE_URL=https://modernancient.mikegrowsgreens.com

# "true" only when this site should be indexed by search engines.
# Stays false while the site lives on an MGG subdomain, so it never competes
# with the practice's real domain.
NEXT_PUBLIC_INDEXABLE=false

# --- Contact form ---
# This is a demo site. With no webhook set, the form does NOT deliver messages
# and the UI says so. It never claims a message was received.
# N8N_CONTACT_WEBHOOK=
