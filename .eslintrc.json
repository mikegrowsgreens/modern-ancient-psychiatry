{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "overrides": [
    {
      "files": ["src/app/**/*.tsx", "src/components/**/*.tsx"],
      "excludedFiles": ["src/content/**"],
      "rules": {
        "react/jsx-no-literals": [
          "warn",
          {
            "noStrings": true,
            "ignoreProps": true,
            "allowedStrings": ["·", "—", "–", "+", "−", "/", ":", "→"]
          }
        ]
      }
    }
  ]
}
